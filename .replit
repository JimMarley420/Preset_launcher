modules = ["dotnet-8.0"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Instructions"

[[workflows.workflow]]
name = "Instructions"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"======================================\" && echo \"Application WinUI 3 - Preset Launcher\" && echo \"======================================\" && echo \"\" && echo \"Ce projet WinUI 3 ne peut etre compile que sur Windows.\" && echo \"Le compilateur XAML est un executable Windows (.exe).\" && echo \"\" && echo \"Pour compiler:\" && echo \"1. Telechargez le dossier PresetLauncherWinUI3/\" && echo \"2. Sur votre machine Windows, ouvrez un terminal\" && echo \"3. Executez: cd PresetLauncherWinUI3 && dotnet build -c Release\" && echo \"\" && echo \"L'executable sera dans bin/Release/net8.0-windows10.0.19041.0/\""

[workflows.workflow.metadata]
outputType = "console"
