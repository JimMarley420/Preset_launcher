<Page x:Class="PresetLauncher.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle" Grid.Row="0"
                   Text="Parametres" 
                   Style="{StaticResource HeadingText}"
                   Margin="0,0,0,32"/>

        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                
                <TextBlock x:Name="TxtLanguageLabel"
                           Text="Langue"
                           Style="{StaticResource SettingsCategoryText}"
                           Margin="0,0,0,8"/>

                <Border Style="{StaticResource Win11SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Width="36" Height="36" 
                                CornerRadius="4" 
                                Background="{DynamicResource NavHoverBrush}"
                                Margin="0,0,16,0">
                            <TextBlock Text="&#xE774;" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       FontSize="16" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Langue d'affichage"
                                       Style="{StaticResource SettingsTitleText}"/>
                            <TextBlock Text="Choisissez la langue de l'interface"
                                       Style="{StaticResource SettingsDescText}"/>
                        </StackPanel>
                        
                        <ComboBox x:Name="CmbLanguage"
                                  Grid.Column="2"
                                  SelectionChanged="CmbLanguage_SelectionChanged"
                                  Style="{StaticResource Win11ComboBox}"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="Francais" Tag="fr"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock x:Name="TxtThemeLabel"
                           Text="Apparence"
                           Style="{StaticResource SettingsCategoryText}"/>

                <Border Style="{StaticResource Win11SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Width="36" Height="36" 
                                CornerRadius="4" 
                                Background="{DynamicResource NavHoverBrush}"
                                Margin="0,0,16,0">
                            <TextBlock Text="&#xE790;" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       FontSize="16" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Theme"
                                       Style="{StaticResource SettingsTitleText}"/>
                            <TextBlock Text="Personnalisez les couleurs de l'application"
                                       Style="{StaticResource SettingsDescText}"/>
                        </StackPanel>
                        
                        <ComboBox x:Name="CmbTheme"
                                  Grid.Column="2"
                                  SelectionChanged="CmbTheme_SelectionChanged"
                                  Style="{StaticResource Win11ComboBox}"
                                  VerticalAlignment="Center">
                            <ComboBoxItem x:Name="ThemeSystem" Content="Systeme" Tag="system"/>
                            <ComboBoxItem x:Name="ThemeLight" Content="Clair" Tag="light"/>
                            <ComboBoxItem x:Name="ThemeDark" Content="Sombre" Tag="dark"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <TextBlock x:Name="TxtOptionsLabel"
                           Text="Options"
                           Style="{StaticResource SettingsCategoryText}"/>

                <Border Style="{StaticResource Win11SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Width="36" Height="36" 
                                CornerRadius="4" 
                                Background="{DynamicResource NavHoverBrush}"
                                Margin="0,0,16,0">
                            <TextBlock Text="&#xE7BA;" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       FontSize="16" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtConfirmLaunch" 
                                       Text="Confirmer avant le lancement"
                                       Style="{StaticResource SettingsTitleText}"/>
                            <TextBlock Text="Demander une confirmation avant d'executer un preset"
                                       Style="{StaticResource SettingsDescText}"/>
                        </StackPanel>
                        
                        <CheckBox x:Name="ChkConfirmLaunch"
                                  Grid.Column="2"
                                  Style="{StaticResource Win11ToggleSwitch}"
                                  Checked="ChkConfirmLaunch_Changed"
                                  Unchecked="ChkConfirmLaunch_Changed"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Win11SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Width="36" Height="36" 
                                CornerRadius="4" 
                                Background="{DynamicResource NavHoverBrush}"
                                Margin="0,0,16,0">
                            <TextBlock Text="&#xEA8F;" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       FontSize="16" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtNotifications" 
                                       Text="Afficher les notifications"
                                       Style="{StaticResource SettingsTitleText}"/>
                            <TextBlock Text="Recevoir des notifications pour les actions importantes"
                                       Style="{StaticResource SettingsDescText}"/>
                        </StackPanel>
                        
                        <CheckBox x:Name="ChkNotifications"
                                  Grid.Column="2"
                                  Style="{StaticResource Win11ToggleSwitch}"
                                  Checked="ChkNotifications_Changed"
                                  Unchecked="ChkNotifications_Changed"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="TxtDataLabel"
                           Text="Donnees"
                           Style="{StaticResource SettingsCategoryText}"/>

                <Border Style="{StaticResource Win11SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Width="36" Height="36" 
                                CornerRadius="4" 
                                Background="{DynamicResource NavHoverBrush}"
                                Margin="0,0,16,0">
                            <TextBlock Text="&#xE838;" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       FontSize="16" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtDataPathLabel" 
                                       Text="Emplacement des donnees"
                                       Style="{StaticResource SettingsTitleText}"/>
                            <TextBox x:Name="TxtDataPath"
                                     Style="{StaticResource ModernTextBox}"
                                     IsReadOnly="True"
                                     Margin="0,4,0,0"
                                     MaxWidth="400"
                                     HorizontalAlignment="Left"/>
                        </StackPanel>
                        
                        <Button x:Name="BtnBrowse" 
                                Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnBrowse_Click"
                                VerticalAlignment="Center"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8DA;" 
                                           FontFamily="Segoe MDL2 Assets" 
                                           FontSize="14" 
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Parcourir"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Win11SettingsCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Width="36" Height="36" 
                                CornerRadius="4" 
                                Background="{DynamicResource NavHoverBrush}"
                                Margin="0,0,16,0">
                            <TextBlock Text="&#xE74D;" 
                                       FontFamily="Segoe MDL2 Assets" 
                                       FontSize="16" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCleanup" 
                                       Text="Nettoyer les executables invalides"
                                       Style="{StaticResource SettingsTitleText}"/>
                            <TextBlock Text="Supprimer les references aux fichiers qui n'existent plus"
                                       Style="{StaticResource SettingsDescText}"/>
                        </StackPanel>
                        
                        <Button x:Name="BtnCleanup"
                                Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnCleanup_Click"
                                VerticalAlignment="Center"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" 
                                           FontFamily="Segoe MDL2 Assets" 
                                           FontSize="14" 
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Nettoyer"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
