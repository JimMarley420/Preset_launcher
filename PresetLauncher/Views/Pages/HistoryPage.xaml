<Page x:Class="PresetLauncher.Views.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource BackgroundBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="TxtTitle" Grid.Column="0"
                       Text="Historique d'exécution" 
                       Style="{StaticResource HeadingText}"/>
            
            <Button x:Name="BtnClear" Grid.Column="1"
                    Style="{StaticResource DangerButton}"
                    Click="BtnClear_Click">
                <TextBlock x:Name="TxtClear" Text="Effacer l'historique"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock x:Name="TxtEmpty" 
                       Text="Aucun historique d'exécution."
                       Style="{StaticResource BodyText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding PresetName}" 
                                                   Style="{StaticResource SubheadingText}"/>
                                        <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0">
                                            <Run Text="{Binding ExecutedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}" 
                                                       Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding SuccessCount}" 
                                                       Style="{StaticResource BodyText}"
                                                       Margin="0,0,16,0"/>
                                            <TextBlock Text="✗" Foreground="{DynamicResource DangerBrush}"
                                                       Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding FailedCount}" 
                                                       Style="{StaticResource BodyText}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Duration, StringFormat='{}{0:mm\\:ss}'}"
                                                   Style="{StaticResource BodyText}"
                                                   HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
