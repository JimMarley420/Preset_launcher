<Window x:Class="PresetLauncher.Views.Dialogs.PresetEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier le preset" 
        Height="600" Width="800"
        MinHeight="400" MinWidth="600"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtNameLabel" Text="Nom du preset" 
                       Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBox}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock x:Name="TxtDescLabel" Text="Description" 
                       Style="{StaticResource BodyText}" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtDescription" Style="{StaticResource ModernTextBox}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtExeLabel" Grid.Column="0" 
                           Text="Exécutables"
                           Style="{StaticResource SubheadingText}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnAddFile" 
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnAddFile_Click"
                            Margin="0,0,8,0">
                        <TextBlock x:Name="TxtAddFile" Text="Depuis un fichier..."/>
                    </Button>
                    <Button x:Name="BtnAddProcess" 
                            Style="{StaticResource SecondaryButton}"
                            Click="BtnAddProcess_Click">
                        <TextBlock x:Name="TxtAddProcess" Text="Depuis les processus..."/>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ExeList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="0,0,0,1"
                                        Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" 
                                                    Orientation="Vertical" 
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,12,0">
                                            <Button Style="{StaticResource IconButton}"
                                                    Tag="{Binding}"
                                                    Click="BtnMoveUp_Click"
                                                    Width="28" Height="28">
                                                <TextBlock Text="▲" FontSize="12"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Tag="{Binding}"
                                                    Click="BtnMoveDown_Click"
                                                    Width="28" Height="28">
                                                <TextBlock Text="▼" FontSize="12"/>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" 
                                                           Style="{StaticResource BodyText}"
                                                           FontWeight="Medium"/>
                                                <TextBlock Text="⚠" 
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           Margin="8,0,0,0"
                                                           Visibility="{Binding IsValid, Converter={StaticResource InverseBoolToVisibility}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" 
                                                       Style="{StaticResource SecondaryText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <CheckBox IsChecked="{Binding RunAsAdmin}"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          Margin="0,0,16,0">
                                                    <TextBlock Text="Admin" FontSize="12"/>
                                                </CheckBox>
                                                <TextBlock Text="Délai:" 
                                                           Style="{StaticResource SecondaryText}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBox Text="{Binding DelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="50"
                                                         Padding="4"
                                                         FontSize="12"/>
                                                <TextBlock Text="s" 
                                                           Style="{StaticResource SecondaryText}"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="2" 
                                                Style="{StaticResource IconButton}"
                                                Tag="{Binding}"
                                                Click="BtnRemoveExe_Click"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="🗑" FontSize="16" 
                                                       Foreground="{DynamicResource DangerBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <CheckBox x:Name="ChkLocked" 
                          Style="{StaticResource ModernCheckBox}"
                          Checked="ChkLocked_Changed"
                          Unchecked="ChkLocked_Changed">
                    <TextBlock x:Name="TxtLock" Text="Verrouiller"/>
                </CheckBox>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnCancel" 
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnCancel_Click"
                        Margin="0,0,8,0">
                    <TextBlock x:Name="TxtCancel" Text="Annuler"/>
                </Button>
                <Button x:Name="BtnSave" 
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnSave_Click">
                    <TextBlock x:Name="TxtSave" Text="Enregistrer"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
