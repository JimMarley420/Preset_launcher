<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PresetLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PresetLauncher"
    Title="">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- PREMIUM TITLE BAR -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.BorderBrush>
                <SolidColorBrush Color="{ThemeResource CardStrokeColorDefault}" Opacity="0.5"/>
            </Grid.BorderBrush>
            <Border BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0" Spacing="12">
                    <!-- Logo Icon with gradient background -->
                    <Border Background="{ThemeResource AccentButtonBackground}" 
                            CornerRadius="8" 
                            Padding="8" 
                            Height="40" 
                            Width="40">
                        <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    
                    <!-- App Title -->
                    <TextBlock x:Name="AppTitleText" 
                               Text="" 
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- MODERN NAVIGATION VIEW -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        IsPaneToggleButtonVisible="True"
                        PaneDisplayMode="Top"
                        OpenPaneLength="260"
                        CompactPaneLength="54"
                        SelectionChanged="NavView_SelectionChanged"
                        Loaded="NavView_Loaded"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavPresets" Content="" Tag="presets">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavHistory" Content="" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavStats" Content="" Tag="statistics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            

            
            <Frame x:Name="ContentFrame" Padding="28,24"/>
        </NavigationView>
    </Grid>
</Window>
