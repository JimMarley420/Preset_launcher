<Window x:Class="PresetLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Border x:Name="OpaqueBackground" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"/>
        <Grid RowDefinitions="32,*">
            <TitleBar x:Name="AppTitleBar"/>
            <NavigationView x:Name="NavView" Grid.Row="1"
                            PaneDisplayMode="LeftCompact" IsPaneOpen="False"
                            OpenPaneLength="192" CompactPaneLength="48"
                            IsBackButtonVisible="Collapsed"
                            Loaded="NavView_Loaded" SizeChanged="NavView_SizeChanged"
                            ItemInvoked="NavView_ItemInvoked">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NavPresets">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavHistory">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Clock"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavStats">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;"/></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </NavigationView>
            <ContentControl x:Name="UpdateHost" Grid.Row="1" Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
