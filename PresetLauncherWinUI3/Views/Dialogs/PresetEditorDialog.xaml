<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PresetLauncher.Views.Dialogs.PresetEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PresetLauncher.Views.Dialogs"
    x:Name="ThisDialog"
    Title=""
    PrimaryButtonText=""
    CloseButtonText=""
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <DataTemplate x:Key="ProcessItemTemplate">
            <StackPanel Spacing="2" Padding="4,6">
                <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="{Binding Path}" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Width="520">

            <!-- Name -->
            <TextBox x:Name="TxtName"
                     Header=""
                     PlaceholderText=""/>

            <!-- Description -->
            <TextBox x:Name="TxtDescription"
                     Header=""
                     PlaceholderText=""
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="72"/>

            <!-- Add buttons -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnAddExe" Click="BtnAddExe_Click"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE710;" FontSize="13"/>
                        <TextBlock x:Name="TxtAddExe" Text=""/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAddFromProcess" Click="BtnAddFromProcess_Click"
                        Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE7C1;" FontSize="13"/>
                        <TextBlock Text="{Binding AddFromProcessText, ElementName=ThisDialog}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="TxtProcessError"
                       Visibility="Collapsed"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Style="{ThemeResource CaptionTextBlockStyle}"/>

            <AutoSuggestBox x:Name="ProcessSuggestBox"
                            PlaceholderText="Rechercher un processus..."
                            Visibility="Collapsed"
                            SuggestionChosen="ProcessSuggestBox_SuggestionChosen"
                            TextChanged="ProcessSuggestBox_TextChanged"/>

            <TextBlock Text="{Binding ProcessSearchHint, ElementName=ThisDialog}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- Exe list -->
            <ListView x:Name="ExeList"
                      SelectionMode="None"
                      MaxHeight="380">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Name + path -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{Binding Path}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Remove button -->
                                <Button Grid.Row="0" Grid.Column="1"
                                        Tag="{Binding}"
                                        Click="BtnRemoveExe_Click"
                                        Padding="8,6"
                                        VerticalAlignment="Top">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Button>

                                <!-- Options row -->
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="20">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7EF;" FontSize="13"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  VerticalAlignment="Center"/>
                                        <ToggleSwitch IsOn="{Binding RunAsAdmin, Mode=TwoWay}"
                                                      OnContent="{Binding ExeAdmin, ElementName=ThisDialog}"
                                                      OffContent="{Binding ExeNormal, ElementName=ThisDialog}"
                                                      MinWidth="0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE823;" FontSize="13"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  VerticalAlignment="Center"/>
                                        <NumberBox Value="{Binding DelaySeconds, Mode=TwoWay}"
                                                   Minimum="0"
                                                   Maximum="300"
                                                   SpinButtonPlacementMode="Compact"
                                                   SmallChange="1"
                                                   LargeChange="5"
                                                   Width="110"/>
                                        <TextBlock Text="{Binding ExeSec, ElementName=ThisDialog}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
