<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PresetLauncher.Views.Dialogs.PresetEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PresetLauncher.Views.Dialogs"
    x:Name="ThisDialog"
    Title=""
    PrimaryButtonText=""
    CloseButtonText=""
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <DataTemplate x:Key="ProcessItemTemplate">
            <StackPanel Orientation="Vertical" Padding="8">
                <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="{Binding Path}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="700" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MinWidth="500">
            
            <TextBox x:Name="TxtName" 
                     Header=""
                     PlaceholderText=""/>
            
            <TextBox x:Name="TxtDescription" 
                     Header=""
                     PlaceholderText=""
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="80"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnAddExe" Click="BtnAddExe_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock x:Name="TxtAddExe" Text=""/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAddFromProcess" Click="BtnAddFromProcess_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7C1;" FontSize="14"/>
                        <TextBlock Text="{Binding AddFromProcessText, ElementName=ThisDialog}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="TxtProcessError" Visibility="Collapsed" Foreground="Red" Style="{ThemeResource CaptionTextBlockStyle}"/>

            <AutoSuggestBox x:Name="ProcessSuggestBox" 
                            PlaceholderText="Rechercher un processus..." 
                            Visibility="Collapsed"
                            SuggestionChosen="ProcessSuggestBox_SuggestionChosen"
                            TextChanged="ProcessSuggestBox_TextChanged"
                            Margin="0,8,0,0"/>
            <TextBlock Text="{Binding ProcessSearchHint, ElementName=ThisDialog}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>

            <ListView x:Name="ExeList" 
                      SelectionMode="None"
                      MaxHeight="400">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" 
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{Binding Path}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="350"/>
                                </StackPanel>
                                
                                <Button Grid.Row="0" Grid.Column="1" 
                                        Tag="{Binding}"
                                        Click="BtnRemoveExe_Click"
                                        Padding="8"
                                        VerticalAlignment="Top">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                </Button>
                                
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" 
                                            Orientation="Horizontal" 
                                            Spacing="16" 
                                            Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7EF;" FontSize="14" VerticalAlignment="Center"/>
                                        <ToggleSwitch IsOn="{Binding RunAsAdmin, Mode=TwoWay}" 
                                                      OnContent="{Binding ExeAdmin, ElementName=ThisDialog}" 
                                                      OffContent="{Binding ExeNormal, ElementName=ThisDialog}"
                                                      MinWidth="100"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE823;" FontSize="14" VerticalAlignment="Center"/>
                                        <NumberBox Value="{Binding DelaySeconds, Mode=TwoWay}"
                                                   Minimum="0"
                                                   Maximum="300"
                                                   SpinButtonPlacementMode="Compact"
                                                   SmallChange="1"
                                                   LargeChange="5"
                                                   MinWidth="100"/>
                                        <TextBlock Text="{Binding ExeSec, ElementName=ThisDialog}" 
                                                   VerticalAlignment="Center"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
