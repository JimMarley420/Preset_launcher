<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PresetLauncher.Views.Dialogs.PresetEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PresetLauncher.Views.Dialogs"
    x:Name="ThisDialog"
    Title="Nouveau Preset"
    PrimaryButtonText="Enregistrer"
    CloseButtonText="Annuler"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ScrollViewer MaxHeight="500" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MinWidth="500">
            
            <TextBox x:Name="TxtName" 
                     Header="Nom du preset"
                     PlaceholderText="Entrez un nom..."/>
            
            <TextBox x:Name="TxtDescription" 
                     Header="Description"
                     PlaceholderText="Description optionnelle..."
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="80"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnAddExe" Click="BtnAddExe_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="Ajouter un executable"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ListView x:Name="ExeList" 
                      SelectionMode="None"
                      MaxHeight="300">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" 
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{Binding Path}" 
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                
                                <Button Grid.Column="1" 
                                        Tag="{Binding}"
                                        Click="BtnRemoveExe_Click"
                                        Padding="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
