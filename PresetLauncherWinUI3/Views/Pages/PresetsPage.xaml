<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PresetLauncher.Views.Pages.PresetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PresetLauncher.Views.Pages">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== HEADER SECTION ========== -->
        <StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,20">
            <!-- Title -->
            <StackPanel Spacing="6">
                <TextBlock x:Name="TxtPresetsTitle" Text="Presets" 
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PresetCountText"
                           Text="Tous les presets" 
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Controls -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                <Button x:Name="BtnNewPreset" 
                        Style="{ThemeResource AccentButtonStyle}" 
                        Padding="24,10"
                        Click="BtnNewPreset_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                        <TextBlock x:Name="TxtNewPreset" Text="Nouveau preset" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
                
                <Button x:Name="BtnImport" 
                        Padding="16,10"
                        Click="BtnImport_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8B5;" FontSize="16"/>
                        <TextBlock x:Name="TxtImport" Text="Importer"/>
                    </StackPanel>
                </Button>
                
                <!-- Search box with styling -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,4"
                        MaxWidth="300">
                    <AutoSuggestBox x:Name="SearchBox" 
                                    PlaceholderText="Rechercher un preset..." 
                                    QueryIcon="Find"
                                    TextChanged="SearchBox_TextChanged"
                                    BorderThickness="0"
                                    Background="Transparent"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- ========== PRESETS GRID ========== -->
        <ScrollViewer Grid.Row="1">
            <ItemsRepeater x:Name="PresetsRepeater" ItemsSource="{x:Bind FilteredPresets, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="320" MinItemHeight="240" 
                                       MinColumnSpacing="12" MinRowSpacing="12"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <!-- Modern Premium Card -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Header with Icon -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                                    <Border Background="{ThemeResource AccentGreenBrush}" 
                                            CornerRadius="8" 
                                            Padding="10" 
                                            Height="48" 
                                            Width="48"
                                            Opacity="0.15">
                                        <FontIcon Glyph="&#xE8B7;" 
                                                  FontSize="24" 
                                                  Foreground="{ThemeResource AccentGreenBrush}" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" 
                                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Description}" 
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Programs Info -->
                                    <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="8">
                                    <TextBlock x:Name="TxtProgramsLabel" Text="Programmes associes:" 
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ProgramsText}"
                                               Style="{ThemeResource BodyTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiary}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                
                                <!-- Action Buttons -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
                                    <Button x:Name="BtnLaunch" 
                                            Style="{ThemeResource AccentButtonStyle}" 
                                            Tag="{Binding}" 
                                            Padding="16,8"
                                            Click="BtnLaunch_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                                    <TextBlock Text="Lancer" FontWeight="Medium"/>
                                                </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnEdit" 
                                            Tag="{Binding}" 
                                            Padding="10,8"
                                            ToolTipService.ToolTip="Editer"
                                            Click="BtnEdit_Click">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                    </Button>
                                    <Button x:Name="BtnMore" 
                                            Tag="{Binding}" 
                                            Padding="10,8"
                                            ToolTipService.ToolTip="Plus">
                                        <FontIcon Glyph="&#xE712;" FontSize="14"/>
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Fermer les processus" 
                                                                Click="BtnCloseProcesses_Click" 
                                                                Tag="{Binding}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE73E;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="Supprimer" 
                                                                Foreground="{ThemeResource ErrorRedBrush}"
                                                                Click="BtnDelete_Click" 
                                                                Tag="{Binding}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty state -->
        <TextBlock x:Name="TxtNoPresets"
                   Grid.Row="1"
                   Text="Aucun preset"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Page>
