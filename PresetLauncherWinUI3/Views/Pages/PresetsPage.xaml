<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PresetLauncher.Views.Pages.PresetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PresetLauncher.Views.Pages">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="TxtPresetsTitle" Text="Presets"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PresetCountText" Text=""
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <AutoSuggestBox x:Name="SearchBox"
                                PlaceholderText="Rechercher..."
                                QueryIcon="Find"
                                Width="220"
                                TextChanged="SearchBox_TextChanged"/>
                <Button x:Name="BtnImport"
                        Padding="12,8"
                        Click="BtnImport_Click"
                        ToolTipService.ToolTip="Importer">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14"/>
                        <TextBlock x:Name="TxtImport" Text="Importer"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnNewPreset"
                        Style="{ThemeResource AccentButtonStyle}"
                        Padding="16,8"
                        Click="BtnNewPreset_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock x:Name="TxtNewPreset" Text="Nouveau" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Preset list -->
        <ScrollViewer Grid.Row="1">
            <ItemsRepeater x:Name="PresetsRepeater" ItemsSource="{x:Bind FilteredPresets, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Width="40" Height="40"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="18"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding Name}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                                    <TextBlock Text="{Binding ProgramsText}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            Spacing="4" VerticalAlignment="Center">
                                    <Button Style="{ThemeResource AccentButtonStyle}"
                                            Tag="{Binding}"
                                            Padding="14,7"
                                            Click="BtnLaunch_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="13"/>
                                            <TextBlock Text="Lancer" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="{Binding}"
                                            Padding="9,7"
                                            ToolTipService.ToolTip="Modifier"
                                            Click="BtnEdit_Click">
                                        <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                                    </Button>
                                    <Button Tag="{Binding}"
                                            Padding="9,7"
                                            ToolTipService.ToolTip="Plus d'options">
                                        <FontIcon Glyph="&#xE712;" FontSize="13"/>
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Fermer les processus"
                                                                Tag="{Binding}"
                                                                Click="BtnCloseProcesses_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE8BB;"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator/>
                                                <MenuFlyoutItem Text="Supprimer"
                                                                Tag="{Binding}"
                                                                Click="BtnDelete_Click"
                                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE74D;"
                                                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyStatePanel"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Visibility="Collapsed">
            <FontIcon Glyph="&#xE8B7;" FontSize="40"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtNoPresets"
                       Text="Aucun preset"
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center"/>
            <Button Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Padding="20,10"
                    Click="BtnNewPreset_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="Créer un preset" FontWeight="Medium"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>
