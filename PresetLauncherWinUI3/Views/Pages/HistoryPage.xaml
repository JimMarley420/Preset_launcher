<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PresetLauncher.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PresetLauncher.Views.Pages">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== HEADER ========== -->
        <StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,20">
            <StackPanel Spacing="6">
                <TextBlock x:Name="TxtHistoryTitle" Text="" 
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="HistoryCountText"
                           Text="" 
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BtnClear" 
                        Padding="16,10"
                        Click="BtnClear_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                        <TextBlock x:Name="TxtClear" Text="" FontWeight="Medium"/>
                    </StackPanel>
                </Button>
                
                <ComboBox x:Name="FilterCombo" 
                          Padding="12,6"
                          SelectionChanged="FilterCombo_SelectionChanged">
                    <ComboBoxItem x:Name="FilterAll" Content="" IsSelected="True"/>
                    <ComboBoxItem x:Name="FilterSuccess" Content=""/>
                    <ComboBoxItem x:Name="FilterFailures" Content=""/>
                    <ComboBoxItem x:Name="FilterToday" Content=""/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- ========== HISTORY LIST ========== -->
        <ListView x:Name="HistoryList" 
                  Grid.Row="1" 
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Status Icon -->
                            <Border Grid.Column="0" 
                                    Background="{ThemeResource AccentGreenBrush}" 
                                    CornerRadius="8" 
                                    Padding="10" 
                                    Height="48" 
                                    Width="48"
                                    Opacity="0.15"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE768;" 
                                          FontSize="24" 
                                          Foreground="{ThemeResource AccentGreenBrush}" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                            </Border>
                            
                            <!-- Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding PresetName}" 
                                               Style="{ThemeResource SubtitleTextBlockStyle}"
                                               FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE81C;" FontSize="14" 
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ExecutedAt}" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="•" 
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE73E;" FontSize="14" 
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Duration}" 
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Status Badge -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border Background="{ThemeResource AccentGreenBrush}" 
                                        CornerRadius="6" 
                                        Padding="10,6"
                                        Opacity="0.2">
                                    <TextBlock Text="{Binding SuccessText}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource AccentGreenBrush}"
                                               FontWeight="Medium"
                                               TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- ========== EMPTY STATE ========== -->
        <TextBlock x:Name="TxtEmpty"
                   Grid.Row="1"
                   Text="Aucun historique"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Page>
