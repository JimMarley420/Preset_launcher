<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PresetLauncher.Views.Pages.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PresetLauncher.Views.Pages">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="0,0,24,24">
            
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        MinWidth="180">
                    <StackPanel>
                        <TextBlock x:Name="TxtPresetsCount" 
                                   Text="0" 
                                   Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                        <TextBlock x:Name="TxtPresetsLabel" 
                                   Text="Presets" 
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        MinWidth="180">
                    <StackPanel>
                        <TextBlock x:Name="TxtTotalLaunches" 
                                   Text="0" 
                                   Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                        <TextBlock x:Name="TxtTotalLaunchesLabel" 
                                   Text="Lancements totaux" 
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24"
                        MinWidth="180">
                    <StackPanel>
                        <TextBlock x:Name="TxtUniquePrograms" 
                                   Text="0" 
                                   Style="{ThemeResource TitleLargeTextBlockStyle}"/>
                        <TextBlock x:Name="TxtUniqueProgramsLabel" 
                                   Text="Programmes uniques" 
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock x:Name="TxtMostUsed" 
                       Text="Programmes les plus utilises" 
                       Style="{ThemeResource SubtitleTextBlockStyle}"
                       Margin="0,8,0,0"/>

            <ListView x:Name="MostUsedList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <FontIcon Grid.Column="0" 
                                          Glyph="&#xE756;" 
                                          FontSize="20" 
                                          Margin="0,0,16,0"/>
                                
                                <TextBlock Grid.Column="1" 
                                           Text="{Binding Path}" 
                                           Style="{ThemeResource BodyTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Column="2" 
                                           Text="{Binding TimesText}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</Page>
