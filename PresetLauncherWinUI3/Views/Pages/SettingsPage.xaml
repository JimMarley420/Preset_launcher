<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PresetLauncher.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PresetLauncher.Views.Pages">

    <ScrollViewer>
        <StackPanel Spacing="6" Padding="0,0,4,32">

            <!-- Title -->
            <StackPanel Spacing="2" Margin="0,0,0,14">
                <TextBlock x:Name="TxtSettingsTitle" Text="Paramètres"
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtSettingsSubtitle" Text=""
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- ── Apparence ── -->
            <TextBlock x:Name="TxtAppearanceTitle" Text="Apparence"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Margin="4,8,0,4"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <!-- Theme -->
                    <Grid Padding="16,14" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="16"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center" Width="20"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="TxtThemeLabel" Text="Thème"
                                       Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtThemeSubtitle" Text=""
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox x:Name="CmbTheme" Grid.Column="2" MinWidth="150"
                                  SelectionChanged="CmbTheme_SelectionChanged">
                            <ComboBoxItem x:Name="ThemeSystem" Content="Système" Tag="system" IsSelected="True"/>
                            <ComboBoxItem x:Name="ThemeLight" Content="Clair" Tag="light"/>
                            <ComboBoxItem x:Name="ThemeDark" Content="Sombre" Tag="dark"/>
                        </ComboBox>
                    </Grid>

                    <Border BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Language -->
                    <Grid Padding="16,14" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="16"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center" Width="20"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="TxtLanguageLabel" Text="Langue"
                                       Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtLanguageSubtitle" Text=""
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox x:Name="CmbLanguage" Grid.Column="2" MinWidth="150"
                                  SelectionChanged="CmbLanguage_SelectionChanged">
                            <ComboBoxItem x:Name="LangFr" Content="Français" Tag="fr" IsSelected="True"/>
                            <ComboBoxItem x:Name="LangEn" Content="English" Tag="en"/>
                        </ComboBox>
                    </Grid>

                    <Border BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Backdrop -->
                    <Grid Padding="16,14" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE9F1;" FontSize="16"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center" Width="20"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="TxtBackdropLabel" Text="Effet de fond"
                                       Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtBackdropSubtitle" Text=""
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox x:Name="CmbBackdrop" Grid.Column="2" MinWidth="150"
                                  SelectionChanged="CmbBackdrop_SelectionChanged">
                            <ComboBoxItem x:Name="BackdropNone" Content="Aucun" Tag="none" IsSelected="True"/>
                            <ComboBoxItem x:Name="BackdropMica" Content="Mica" Tag="mica"/>
                            <ComboBoxItem x:Name="BackdropAcrylic" Content="Acrylique" Tag="acrylic"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Comportement ── -->
            <TextBlock x:Name="TxtBehaviorTitle" Text="Comportement"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Margin="4,14,0,4"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid Padding="16,14" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="16"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" Width="20"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="TxtConfirmLaunchLabel" Text="Confirmation avant lancement"
                                   Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Medium"/>
                        <TextBlock x:Name="TxtConfirmLaunchSubtitle" Text=""
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="TglConfirmLaunch" Grid.Column="2"
                                  Margin="0" Padding="0"
                                  Toggled="TglConfirmLaunch_Toggled"/>
                </Grid>
            </Border>

            <!-- ── Données ── -->
            <TextBlock x:Name="TxtDataTitle" Text="Données"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Margin="4,14,0,4"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <!-- Data path -->
                    <Grid Padding="16,14" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE838;" FontSize="16"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center" Width="20"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="TxtDataPathLabel" Text="Fichier de données"
                                       Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtDataPathValue" Text=""
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="BtnBrowse" Grid.Column="2"
                                Padding="14,7"
                                Click="BtnBrowse_Click">
                            <TextBlock x:Name="TxtBrowse" Text="Exporter"/>
                        </Button>
                    </Grid>

                    <Border BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Cleanup -->
                    <Grid Padding="16,14" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE74C;" FontSize="16"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  VerticalAlignment="Center" Width="20"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="TxtCleanupLabel" Text="Nettoyage"
                                       Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtCleanupSubtitle" Text=""
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button x:Name="BtnCleanup" Grid.Column="2"
                                Padding="14,7"
                                Click="BtnCleanup_Click">
                            <TextBlock x:Name="TxtCleanupBtn" Text="Nettoyer"/>
                        </Button>
                    </Grid>

                    <Border BorderThickness="0,1,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Reset -->
                    <Grid Padding="16,14" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72C;" FontSize="16"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                  VerticalAlignment="Center" Width="20"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="TxtResetLabel" Text="Réinitialiser"
                                       Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Medium"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            <TextBlock x:Name="TxtResetSubtitle" Text=""
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button x:Name="BtnReset" Grid.Column="2"
                                Padding="14,7"
                                Click="BtnReset_Click"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                            <TextBlock x:Name="TxtResetBtn" Text="Réinitialiser"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── À propos ── -->
            <TextBlock x:Name="TxtAboutTitle" Text="À propos"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Margin="4,14,0,4"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid Padding="16,14" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE783;" FontSize="16"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              VerticalAlignment="Center" Width="20"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="TxtVersionLabel" Text="Version"
                                   Style="{ThemeResource BodyTextBlockStyle}" FontWeight="Medium"/>
                        <TextBlock x:Name="TxtVersionValue" Text=""
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <Button x:Name="BtnCheckUpdate" Grid.Column="2"
                            Padding="14,7"
                            Click="BtnCheckUpdate_Click">
                        <TextBlock x:Name="TxtCheckUpdateBtn" Text="Vérifier les mises à jour"/>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
