<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PresetLauncher.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PresetLauncher.Views.Pages">

    <ScrollViewer>
        <StackPanel Spacing="4" Padding="0,0,24,24" MaxWidth="800" HorizontalAlignment="Left">
            
            <TextBlock x:Name="TxtLanguageCategory" 
                       Text="Langue" 
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Margin="0,0,0,8"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="20" Margin="0,0,16,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Langue d'affichage" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Text="Choisissez la langue de l'interface" 
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    
                    <ComboBox x:Name="CmbLanguage" 
                              Grid.Column="2" 
                              MinWidth="160"
                              SelectionChanged="CmbLanguage_SelectionChanged">
                        <ComboBoxItem Content="Francais" Tag="fr"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock x:Name="TxtThemeCategory" 
                       Text="Apparence" 
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Margin="0,16,0,8"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="20" Margin="0,0,16,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Theme" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Text="Personnalisez les couleurs de l'application" 
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    
                    <ComboBox x:Name="CmbTheme" 
                              Grid.Column="2" 
                              MinWidth="160"
                              SelectionChanged="CmbTheme_SelectionChanged">
                        <ComboBoxItem x:Name="ThemeSystem" Content="Systeme" Tag="system"/>
                        <ComboBoxItem x:Name="ThemeLight" Content="Clair" Tag="light"/>
                        <ComboBoxItem x:Name="ThemeDark" Content="Sombre" Tag="dark"/>
                    </ComboBox>
                </Grid>
            </Border>

            <TextBlock x:Name="TxtOptionsCategory" 
                       Text="Options" 
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Margin="0,16,0,8"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="20" Margin="0,0,16,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtConfirmLaunch" 
                                   Text="Confirmer avant le lancement" 
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Text="Demander une confirmation avant d'executer un preset" 
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    
                    <ToggleSwitch x:Name="TglConfirmLaunch" 
                                  Grid.Column="2"
                                  OnContent="" OffContent=""
                                  Toggled="TglConfirmLaunch_Toggled"/>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <FontIcon Grid.Column="0" Glyph="&#xEA8F;" FontSize="20" Margin="0,0,16,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNotifications" 
                                   Text="Afficher les notifications" 
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Text="Recevoir des notifications pour les actions importantes" 
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    
                    <ToggleSwitch x:Name="TglNotifications" 
                                  Grid.Column="2"
                                  OnContent="" OffContent=""
                                  Toggled="TglNotifications_Toggled"/>
                </Grid>
            </Border>

            <TextBlock x:Name="TxtDataCategory" 
                       Text="Donnees" 
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       Margin="0,16,0,8"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <FontIcon Grid.Column="0" Glyph="&#xE838;" FontSize="20" Margin="0,0,16,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="TxtDataPath" 
                                   Text="Emplacement des donnees" 
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock x:Name="TxtDataPathValue"
                                   Text="" 
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="400"/>
                    </StackPanel>
                    
                    <Button x:Name="BtnBrowse" 
                            Grid.Column="2"
                            Click="BtnBrowse_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8DA;" FontSize="14"/>
                            <TextBlock Text="Parcourir"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,12"
                    Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <FontIcon Grid.Column="0" Glyph="&#xE74D;" FontSize="20" Margin="0,0,16,0"/>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCleanup" 
                                   Text="Nettoyer les executables invalides" 
                                   Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBlock Text="Supprimer les references aux fichiers qui n'existent plus" 
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    
                    <Button x:Name="BtnCleanup" 
                            Grid.Column="2"
                            Click="BtnCleanup_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            <TextBlock Text="Nettoyer"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
