<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PresetLauncher.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PresetLauncher.Views.Pages">

    <ScrollViewer>
        <StackPanel Spacing="20" Padding="0,0,24,32">
            
            <!-- ========== TITLE ========== -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="TxtSettingsTitle" Text="Paramètres" 
                           Style="{ThemeResource TitleLargeTextBlockStyle}"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtSettingsSubtitle" Text="Personnalisez l'apparence et le comportement de l'application" 
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            
            <!-- ========== APPEARANCE SECTION ========== -->
            <StackPanel Spacing="12">
                <TextBlock x:Name="TxtAppearanceTitle" Text="Apparence" 
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <!-- Theme Selection -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Background="{ThemeResource PrimaryBlueBrush}" 
                                CornerRadius="8" 
                                Padding="10" 
                                Height="44" 
                                Width="44">
                            <FontIcon Glyph="&#xE790;" FontSize="20" Foreground="White" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtThemeLabel" Text="Thème" 
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       FontWeight="Medium"/>
                            <TextBlock x:Name="TxtThemeSubtitle" Text="Choisissez le thème de l'application" 
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <ComboBox x:Name="CmbTheme" 
                                  Grid.Column="2" 
                                  MinWidth="160"
                                  SelectionChanged="CmbTheme_SelectionChanged">
                            <ComboBoxItem x:Name="ThemeSystem" Content="Système" Tag="system" IsSelected="True"/>
                            <ComboBoxItem x:Name="ThemeLight" Content="Clair" Tag="light"/>
                            <ComboBoxItem x:Name="ThemeDark" Content="Sombre" Tag="dark"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Language Selection -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Background="{ThemeResource PrimaryPurpleBrush}" 
                                CornerRadius="8" 
                                Padding="10" 
                                Height="44" 
                                Width="44">
                            <FontIcon Glyph="&#xE774;" FontSize="20" Foreground="White" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtLanguageLabel" Text="Langue" 
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       FontWeight="Medium"/>
                            <TextBlock x:Name="TxtLanguageSubtitle" Text="Langue de l'interface" 
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <ComboBox x:Name="CmbLanguage" 
                                  Grid.Column="2" 
                                  MinWidth="160"
                                  SelectionChanged="CmbLanguage_SelectionChanged">
                            <ComboBoxItem x:Name="LangFr" Content="Français" Tag="fr" IsSelected="True"/>
                            <ComboBoxItem x:Name="LangEn" Content="Anglais" Tag="en"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Backdrop/Materials -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Background="{ThemeResource AccentGreenBrush}" 
                                CornerRadius="8" 
                                Padding="10" 
                                Height="44" 
                                Width="44">
                            <FontIcon Glyph="&#xE9F1;" FontSize="20" Foreground="White" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtBackdropLabel" Text="Effet de fond" 
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       FontWeight="Medium"/>
                            <TextBlock x:Name="TxtBackdropSubtitle" Text="Choisissez un matériau pour la fenêtre" 
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <ComboBox x:Name="CmbBackdrop" 
                                  Grid.Column="2" 
                                  MinWidth="160"
                                  SelectionChanged="CmbBackdrop_SelectionChanged">
                            <ComboBoxItem x:Name="BackdropNone" Content="Aucun" Tag="none" IsSelected="True"/>
                            <ComboBoxItem x:Name="BackdropMica" Content="Mica" Tag="mica"/>
                            <ComboBoxItem x:Name="BackdropAcrylic" Content="Acrylique" Tag="acrylic"/>
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ========== BEHAVIOR SECTION ========== -->
            <StackPanel Spacing="12">
                <TextBlock x:Name="TxtBehaviorTitle" Text="Comportement" 
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <!-- Confirm Launch -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Background="{ThemeResource WarningAmberBrush}" 
                                CornerRadius="8" 
                                Padding="10" 
                                Height="44" 
                                Width="44">
                            <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="White" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtConfirmLaunchLabel" Text="Confirmer avant lancement" 
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       FontWeight="Medium"/>
                            <TextBlock x:Name="TxtConfirmLaunchSubtitle" Text="Afficher une confirmation avant de lancer un preset" 
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <ToggleSwitch x:Name="TglConfirmLaunch" 
                                      Grid.Column="2"
                                      Toggled="TglConfirmLaunch_Toggled"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ========== DATA SECTION ========== -->
            <StackPanel Spacing="12">
                <TextBlock x:Name="TxtDataTitle" Text="Données" 
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <!-- Data Path -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Background="{ThemeResource PrimaryBlueBrush}" 
                                CornerRadius="8" 
                                Padding="10" 
                                Height="44" 
                                Width="44">
                            <FontIcon Glyph="&#xE838;" FontSize="20" Foreground="White" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtDataPathLabel" Text="Chemin des données" 
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       FontWeight="Medium"/>
                            <TextBlock x:Name="TxtDataPathValue" 
                                       Text="Aucun chemin défini" 
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        
                        <Button x:Name="BtnBrowse" 
                                Grid.Column="2" 
                                Content="Parcourir..."
                                Click="BtnBrowse_Click"
                                Padding="16,8"/>
                    </Grid>
                </Border>

                <!-- Cleanup -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Background="{ThemeResource WarningAmberBrush}" 
                                CornerRadius="8" 
                                Padding="10" 
                                Height="44" 
                                Width="44">
                            <FontIcon Glyph="&#xE74C;" FontSize="20" Foreground="White" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCleanupLabel" Text="Nettoyage" 
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       FontWeight="Medium"/>
                            <TextBlock x:Name="TxtCleanupSubtitle" Text="Supprime les fichiers temporaires et obsolètes" 
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <Button x:Name="BtnCleanup" 
                                Grid.Column="2" 
                                Content="Nettoyer"
                                Click="BtnCleanup_Click"
                                Padding="16,8"/>
                    </Grid>
                </Border>

                <!-- Reset -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Background="{ThemeResource ErrorRedBrush}" 
                                CornerRadius="8" 
                                Padding="10" 
                                Height="44" 
                                Width="44">
                            <FontIcon Glyph="&#xE72C;" FontSize="20" Foreground="White" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtResetLabel" Text="Réinitialiser" 
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       FontWeight="Medium"/>
                            <TextBlock x:Name="TxtResetSubtitle" Text="Réinitialise les paramètres aux valeurs par défaut" 
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <Button x:Name="BtnReset" 
                                Grid.Column="2" 
                                Content="Réinitialiser"
                                Click="BtnReset_Click"
                                Padding="16,8"
                                Foreground="{ThemeResource ErrorRedBrush}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ========== ABOUT SECTION ========== -->
            <StackPanel Spacing="12">
                <TextBlock x:Name="TxtAboutTitle" Text="À propos" 
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <!-- Version -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20,16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Background="{ThemeResource PrimaryPurpleBrush}" 
                                CornerRadius="8" 
                                Padding="10" 
                                Height="44" 
                                Width="44">
                            <FontIcon Glyph="&#xE783;" FontSize="20" Foreground="White" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVersionLabel" Text="Version" 
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       FontWeight="Medium"/>
                            <TextBlock x:Name="TxtVersionValue" 
                                       Text="Non disponible" 
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <Button x:Name="BtnCheckUpdate" 
                                Grid.Column="2" 
                                Content="Vérifier les mises à jour"
                                Click="BtnCheckUpdate_Click"
                                Padding="16,8"/>
                    </Grid>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
