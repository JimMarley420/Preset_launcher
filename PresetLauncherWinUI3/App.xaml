<Application x:Class="PresetLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:PresetLauncher.Views.Pages">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DesktopPageTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="DesktopSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="DesktopSecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="DesktopAccentIcon" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Style>
            <Style x:Key="DesktopMetric" TargetType="TextBlock" BasedOn="{StaticResource DesktopSectionTitle}">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            </Style>
            <Style x:Key="DesktopWarningText" TargetType="TextBlock" BasedOn="{StaticResource DesktopSecondaryText}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}"/>
            </Style>
            <Style x:Key="DesktopDivider" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="0,8"/>
            </Style>
            <Style x:Key="HistorySuccessIcon" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}"/>
            </Style>
            <Style x:Key="HistoryPartialIcon" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}"/>
            </Style>
            <Style x:Key="HistoryFailureIcon" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
            </Style>
            <DataTemplate x:Key="HistoryRowTemplate">
                <pages:HistoryRow/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
